{
    "ConnectionStrings": {
        "Database": "Host=localhost;Port=5432;Database=kanban;Username=postgres;Password=root"
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Seq"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Seq",
                "Args": { "ServerUrl": "http://localhost:5000" }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
    },
    "Jwt": {
        "Secret": "OfAllTheThingsIveLostIMissMyBrainTheMost",
        "Issuer": "clean",
        "Audience": "users",
        "ExpirationInMinutes": 60
    },
    "Redis": {
        "ConnectionString": "localhost:6379"
    }
}
